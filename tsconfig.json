{
  "compilerOptions": {
    // Environment and ECMAScript features
    "lib": ["ES2024"],
    "target": "ES2024",
    "module": "esnext",
    "moduleDetection": "force",
    "allowJs": false,
    "checkJs": false,

    // Module resolution
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Type checking - Strict mode
    "strict": true,

    // Type checking - Additional checks
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false,

    // Error reporting
    "pretty": true,
    "noErrorTruncation": true,

    // Optimization
    "skipLibCheck": true,

    // Performance improvements
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",

    // Path resolution
    "baseUrl": "${configDir}",
    "rootDir": "${configDir}",
    "paths": {
      "@/*": ["${configDir}/src/*"]
    },

    // DX improvements
    "allowSyntheticDefaultImports": true,
    "preserveWatchOutput": true,

    // Decorator support
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "types": ["node", "bun"]
  },
  "include": ["${configDir}/src", "${configDir}/scripts/**/*.ts", "${configDir}/tests", "${configDir}/vite.config.ts", "${configDir}/vitest.config.ts", "${configDir}/**/*.d.ts"],
  "exclude": ["${configDir}/node_modules", "${configDir}/coverage", "${configDir}/**/dist/**", "${configDir}/**/build/**"]
}
